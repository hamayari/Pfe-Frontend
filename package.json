{
  "name": "gestion-pro-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm run fix:watch\" \"ng serve --open --proxy-config proxy.conf.json\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve": "ng serve --proxy-config proxy.conf.json",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "lint": "eslint --ext .ts,.html --fix ./src/",
    "fix": "npm run format && npm run lint",
    "fix:watch": "onchange \"src/**/*.{ts,html,scss,json}\" -- npm run fix"
  },
  "lint-staged": {
    "src/**/*.{ts,html,scss,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^15.2.10",
    "@angular/cdk": "^15.2.9",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/material": "^15.2.9",
    "@angular/material-moment-adapter": "^15.2.9",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "@angular/router": "^15.2.10",
    "@angular/service-worker": "^15.2.10",
    "@stomp/stompjs": "^7.2.0",
    "@swimlane/ngx-charts": "^20.1.0",
    "@types/chart.js": "^4.0.1",
    "@types/sockjs-client": "^1.5.4",
    "bootstrap": "^5.3.2",
    "chart.js": "^3.9.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "concurrently": "^9.2.1",
    "d3": "^7.8.5",
    "date-fns": "^4.1.0",
    "file-saver": "^2.0.5",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "moment": "^2.30.1",
    "rxjs": "~7.5.0",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.1502.11",
    "@angular-devkit/build-angular": "^15.2.11",
    "@angular-devkit/core": "^15.2.11",
    "@angular-devkit/schematics": "^15.2.11",
    "@angular/cli": "^15.2.11",
    "@angular/compiler-cli": "^15.2.10",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.7",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~4.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.0.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~4.9.4"
  }
}
